      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "ESP32: Flash Sample Project",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/esp32/invoke-idf.ps1",
        "-ProjectDir",
        "${workspaceFolder}/${config:esp32Project.sampleProjectPath}",
        "-IdfPath",
        "${config:esp32Project.idfPath}",
        "-Port",
        "${config:esp32Project.serialPort}",
        "-Baud",
        "${config:esp32Project.flashBaudRate}",
        "flash"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "ESP32: Monitor Sample Project",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/esp32/invoke-idf.ps1",
        "-ProjectDir",
        "${workspaceFolder}/${config:esp32Project.sampleProjectPath}",
        "-IdfPath",
        "${config:esp32Project.idfPath}",
        "-Port",
        "${config:esp32Project.serialPort}",
        "monitor"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "ESP32: OpenOCD Server",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/esp32/start-openocd.ps1",
        "-IdfPath",
        "${config:esp32Project.idfPath}",
        "-OpenOcdPath",
        "${config:esp32Project.openOcdPath}",
        "-OpenOcdScripts",
        "${config:esp32Project.openOcdScripts}",
        "-AdapterSpeedKHz",
        "${config:esp32Project.openOcdAdapterSpeedKHz}",
        "-OpenOcdConfig",
        "${config:esp32Project.openOcdConfig}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "focus": false,
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "esp32-openocd",
        "pattern": {
          "regexp": "^(Error: .*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^(Activating ESP-IDF|Open On-Chip Debugger)",
          "endsPattern": "Listening on port 3333 for gdb connections"
        }
      }
    },
    {
      "label": "ESP32: OpenOCD Server (Live Attach)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/esp32/start-openocd.ps1",
        "-IdfPath",
        "${config:esp32Project.idfPath}",
        "-OpenOcdPath",
        "${config:esp32Project.openOcdPath}",
        "-OpenOcdScripts",
        "${config:esp32Project.openOcdScripts}",
        "-AdapterSpeedKHz",
        "${config:esp32Project.openOcdAdapterSpeedKHz}",
        "-OpenOcdConfig",
        "${config:esp32Project.openOcdConfig}",
        "-ResumeTargetAfterStartup"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "focus": false,
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "esp32-openocd",
        "pattern": {
          "regexp": "^(Error: .*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^(Activating ESP-IDF|Open On-Chip Debugger)",
          "endsPattern": "^ESP32_LIVE_ATTACH_READY$"
        }
      }
    },
    {
      "label": "ESP32: Prepare Hello World Debug",
      "dependsOrder": "sequence",
      "dependsOn": [
        "ESP32: Build Hello World (Debug Hold)",
        "ESP32: OpenOCD Server"
      ],
      "problemMatcher": []
    },
    {
      "label": "ESP32: Prepare Hello World Live Attach",
      "dependsOrder": "sequence",
      "dependsOn": [
        "ESP32: Build Hello World",
        "ESP32: OpenOCD Server (Live Attach)"
      ],
      "problemMatcher": []
    },
