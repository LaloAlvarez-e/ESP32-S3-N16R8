{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ESP32: List Serial Ports",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/esp32/list-serial-ports.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "ESP32: Build Hello World",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/esp32/invoke-idf.ps1",
        "-ProjectDir",
        "${workspaceFolder}/${config:esp32Project.helloWorldPath}",
        "-IdfPath",
        "${config:esp32Project.idfPath}",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DHELLO_WORLD_PROJECT_DEBUG_STARTUP_HOLD_MS=0",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "ESP32: Build Hello World (Debug Hold)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/esp32/invoke-idf.ps1",
        "-ProjectDir",
        "${workspaceFolder}/${config:esp32Project.helloWorldPath}",
        "-IdfPath",
        "${config:esp32Project.idfPath}",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DHELLO_WORLD_PROJECT_DEBUG_STARTUP_HOLD_MS=${config:esp32Project.helloWorldDebugStartupHoldMs}",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "ESP32: Flash Hello World",
      "type": "shell",
      "command": "powershell",
      "args": [
