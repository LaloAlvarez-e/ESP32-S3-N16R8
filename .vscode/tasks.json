        "${workspaceFolder}/${config:esp32Project.helloWorldPath}",
        "-IdfPath",
        "${config:esp32Project.idfPath}",
        "-Port",
        "${config:esp32Project.serialPort}",
        "-Baud",
        "${config:esp32Project.flashBaudRate}",
        "flash"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
