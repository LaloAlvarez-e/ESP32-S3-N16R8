  ],
  "inputs": [
    {
      "id": "esp32CustomProjectRelativePath",
      "type": "promptString",
      "description": "Workspace-relative ESP-IDF project folder",
      "default": "my_new_project"
    },
    {
      "id": "esp32CustomElfFileName",
      "type": "promptString",
      "description": "ELF file name inside the build folder",
      "default": "my_new_project.elf"
    },
    {
      "id": "esp32CustomBreakpointSymbol",
      "type": "promptString",
      "description": "Breakpoint symbol after reset",
      "default": "app_main"
    }
  ]
