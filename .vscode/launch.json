{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ESP32S3: Hello World (Recommended Attach Running Firmware)",
      "type": "gdbtarget",
      "request": "attach",
      "program": "${workspaceFolder}/${config:esp32Project.helloWorldPath}/build/hello_world_project.elf",
      "cwd": "${workspaceFolder}/${config:esp32Project.helloWorldPath}",
      "gdb": "${config:esp32Project.gdbPath}",
      "runOpenOCD": false,
      "target": {
        "type": "extended-remote",
        "host": "localhost",
        "port": "3333"
      },
      "initCommands": [
        "set pagination off",
        "set remotetimeout 10",
        "monitor halt"
      ],
      "initialBreakpoint": "",
      "preLaunchTask": "ESP32: Prepare Hello World Live Attach",
      "gdbAsync": true
    },
    {
      "name": "ESP32S3: Hello World (Connect To Existing OpenOCD)",
      "type": "gdbtarget",
      "request": "attach",
      "program": "${workspaceFolder}/${config:esp32Project.helloWorldPath}/build/hello_world_project.elf",
      "cwd": "${workspaceFolder}/${config:esp32Project.helloWorldPath}",
      "gdb": "${config:esp32Project.gdbPath}",
      "runOpenOCD": false,
      "target": {
        "type": "extended-remote",
        "host": "localhost",
        "port": "3333"
      },
      "initCommands": [
        "set pagination off",
        "set remotetimeout 10",
        "monitor halt"
      ],
      "initialBreakpoint": "",
      "openGdbConsole": true,
      "gdbAsync": true
    },
    {
      "name": "ESP32S3: Hello World (Reset And Load)",
      "type": "gdbtarget",
      "request": "attach",
      "program": "${workspaceFolder}/${config:esp32Project.helloWorldPath}/build/hello_world_project.elf",
      "cwd": "${workspaceFolder}/${config:esp32Project.helloWorldPath}",
      "gdb": "${config:esp32Project.gdbPath}",
      "runOpenOCD": false,
      "target": {
        "type": "extended-remote",
        "host": "localhost",
        "port": "3333"
      },
      "initCommands": [
        "set pagination off",
        "set remotetimeout 10",
        "monitor reset halt",
        "load"
      ],
      "initialBreakpoint": "app_main",
      "preLaunchTask": "ESP32: Prepare Hello World Debug",
      "gdbAsync": true
    },
